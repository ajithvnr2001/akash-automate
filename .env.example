# ==============================================================================
# Sample .env file for akash-automate
# Copy this file to .env and fill in whichever APIs you want injected into the box:
#   cp .env.example .env
#
# When you run .\deploy.ps1, all non-empty keys are automatically loaded into
# /root/.agent-env and /home/akash/.agent-env in ONE CLICK.
# ==============================================================================

# --- Akash Console Deployment ---
AKASH_API_KEY=

# --- Supabase OpenCode Session Database Sync ---
# Automatically restores prior chat sessions on spin up and persists new sessions
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-service-role-or-anon-key>
SUPABASE_PAT=sbp_<personal-access-token>
OPENCODE_SESSION_ID=default

# --- AI Model APIs ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=

# --- Cloud & Storage APIs ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

OCI_CLI_USER=
OCI_CLI_TENANCY=
OCI_CLI_FINGERPRINT=

# --- Custom Agent Variables ---
DEFAULT_MODEL=deepseek/deepseek-chat

