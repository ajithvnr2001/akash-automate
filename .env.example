# ==============================================================================
# Sample .env file for akash-automate
# ==============================================================================
# Quick Start for Beginners:
# 1. Copy this file to .env:
#      copy .env.example .env     (Windows Command Prompt)
#      cp .env.example .env       (PowerShell or Linux / macOS)
# 2. Fill in your API keys below (at least AKASH_API_KEY is required).
# 3. If you want automatic chat session persistence across VM destructions,
#    fill in your SUPABASE_URL and SUPABASE_KEY.
# 4. Run:
#      .\deploy.ps1
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Akash Console API Key (REQUIRED)
# ------------------------------------------------------------------------------
# Get your API key from Akash Console:
# https://console.akash.network -> Settings -> API Keys -> Create API Key
AKASH_API_KEY=ac.sk.production.replace_with_your_akash_api_key

# ------------------------------------------------------------------------------
# 2. Supabase Real-Time Session Persistence (RECOMMENDED)
# ------------------------------------------------------------------------------
# Keeps your OpenCode chat sessions, agents, and workspace settings permanently
# saved in Supabase. Even if you destroy the VM and spin up a new one, all your
# chat history and sessions automatically restore on first boot!
#
# Get these from Supabase Dashboard (https://supabase.com/dashboard):
#   - SUPABASE_URL: Project Settings -> Data API -> Project URL
#   - SUPABASE_KEY: Project Settings -> Data API -> service_role secret (or anon key)
#   - SUPABASE_PAT: Account -> Access Tokens -> Generate new token (optional, for project automation)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJh...replace_with_your_supabase_service_role_key
SUPABASE_PAT=sbp_replace_with_your_supabase_personal_access_token
OPENCODE_SESSION_ID=default

# ------------------------------------------------------------------------------
# 3. AI Model Provider API Keys (OPTIONAL)
# ------------------------------------------------------------------------------
# Injected automatically into the container (/root/.agent-env and /home/akash/.agent-env)
# so OpenCode, Claude Code, and Aider have immediate access:
OPENAI_API_KEY=sk-proj-replace_with_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-api03-replace_with_anthropic_key
DEEPSEEK_API_KEY=sk-replace_with_deepseek_key
GEMINI_API_KEY=AIzaSy-replace_with_gemini_key
OPENROUTER_API_KEY=sk-or-replace_with_openrouter_key
GROQ_API_KEY=gsk_replace_with_groq_key
MISTRAL_API_KEY=replace_with_mistral_key
PERPLEXITY_API_KEY=pplx-replace_with_perplexity_key
COHERE_API_KEY=replace_with_cohere_key

# ------------------------------------------------------------------------------
# 4. Cloud Provider Credentials (OPTIONAL)
# ------------------------------------------------------------------------------
# Injected for gcloud, aws, az, and oci CLIs:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

OCI_CLI_USER=
OCI_CLI_TENANCY=
OCI_CLI_FINGERPRINT=

# ------------------------------------------------------------------------------
# 5. Default Model Selection (OPTIONAL)
# ------------------------------------------------------------------------------
DEFAULT_MODEL=deepseek/deepseek-chat
